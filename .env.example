# Evaluation / benchmark harness environment (repo root).
# Loaded by backend/app/evaluation/run_benchmark.py and backend/app/config.py.
# Copy to .env and fill in real values:  cp .env.example .env
#
# SAFETY: every DB pointer below MUST target the ISOLATED eval database
# (name MUST contain "eval"), NEVER production. The seeder refuses any DB
# whose name lacks "eval".

# --- Google Gemini (LLM + embeddings) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Backend RAG/embeddings + app.db engine (no-S names), pointed at EVAL DB ---
POSTGRE_USER=mcp-app
POSTGRE_PASS=mcp-app-pass
POSTGRE_IP=localhost
POSTGRE_PORT=5432
POSTGRE_DB_NAME=life-tracker-eval

# --- Eval seeder/teardown guard vars (name MUST contain "eval") ---
EVAL_POSTGRE_USER=mcp-app
EVAL_POSTGRE_PASS=mcp-app-pass
EVAL_POSTGRE_IP=localhost
EVAL_POSTGRE_PORT=5432
EVAL_POSTGRE_DB_NAME=life-tracker-eval

# --- LangSmith tracing (optional; harmless for a smoke run) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT="life-os-eval"
