# Backend (FastAPI + LangGraph) environment.
# Copy to .env and fill in real values:  cp .env.example .env

# --- Google Gemini (LLM + embeddings) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- PostgreSQL (app + RAG/pgvector). Must match mcp_server/.env DB. ---
POSTGRE_USER=mcp-app
POSTGRE_PASS=mcp-app-pass
POSTGRE_IP=localhost
POSTGRE_PORT=5432
POSTGRE_DB_NAME=life-tracker

# --- Cost accounting (optional; Gemini price per 1,000 tokens) ---
# PRICE_IN_PER_1K=0.0005
# PRICE_OUT_PER_1K=0.003

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT="life-os"
