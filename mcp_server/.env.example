# MCP server (Life_OS_Tools) environment.
# Copy to .env and fill in real values:  cp .env.example .env
#
# IMPORTANT: point this at the SAME database as backend/.env. The tracking
# agent writes through this server, so a mismatch sends writes to the wrong DB.

POSTGRE_USER=mcp-app
POSTGRE_PASS=mcp-app-pass
POSTGRE_IP=localhost
POSTGRE_PORT=5432
POSTGRE_DB_NAME=life-tracker
